# 로컬 PostgreSQL 접속 정보 (pgvector를 사용할 데이터베이스)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gre
SPRING_DATASOURCE_USERNAME=gre
SPRING_DATASOURCE_PASSWORD=replace-with-local-db-password

# Spring AI의 OpenAI 채팅 및 임베딩
OPENAI_API_KEY=replace-with-openai-api-key

# Gmail 로컬 테스트용 Basic Auth 비밀번호
GRE_GMAIL_TEST_PASSWORD=

# Google OAuth 웹 클라이언트
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/gmail/oauth2/callback

# Gmail token encryption key (Base64-encoded 32 bytes)
GRE_GMAIL_TOKEN_ENCRYPTION_KEY=

# 테스트 환경에서 ID 기반 세션 로그인 활성화
GRE_DEV_TEST_LOGIN_ENABLED=false
