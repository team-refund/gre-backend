<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teamrefund.gre.dao.community.FreePostDao">
    <resultMap id="result" type="com.teamrefund.gre.entity.community.FreePost">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="viewCount" column="view_count"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="columns">
        id, user_id, title, content, view_count,
        created_at, updated_at
    </sql>

    <insert id="insertPost" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO free_posts (
            user_id, title, content
        )
        VALUES (
            #{userId}, #{title}, #{content}
        )
    </insert>

    <update id="updatePost">
        UPDATE free_posts
        SET title = #{title},
            content = #{content},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
          AND user_id = #{userId}
    </update>

    <delete id="deletePost">
        DELETE FROM free_posts
        WHERE id = #{postId}
          AND user_id = #{userId}
    </delete>

    <select id="findLatest" resultMap="result">
        SELECT <include refid="columns"/>
        FROM free_posts
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit}
    </select>

    <select id="findPage" resultMap="result">
        SELECT <include refid="columns"/>
        FROM free_posts
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countPosts" resultType="long">
        SELECT COUNT(*)
        FROM free_posts
    </select>

    <select id="findById" resultMap="result">
        SELECT <include refid="columns"/>
        FROM free_posts
        WHERE id = #{postId}
    </select>
</mapper>
