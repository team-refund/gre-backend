<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teamrefund.gre.dao.cases.CaseEvidenceDao">
    <resultMap id="caseEvidence" type="com.teamrefund.gre.entity.cases.CaseEvidence">
        <id property="id" column="id"/>
        <result property="caseId" column="case_id"/>
        <result property="evidenceType" column="evidence_type"/>
        <result property="description" column="description"/>
        <result property="originalFilename" column="original_filename"/>
        <result property="storedFilename" column="stored_filename"/>
        <result property="filePath" column="file_path"/>
        <result property="fileSize" column="file_size"/>
        <result property="contentType" column="content_type"/>
        <result property="caseEvidencesAnalysisStatus" column="case_evidences_analysis_status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 백엔드 파일 시스템에 저장된 증빙의 경로와 메타데이터를 등록한다. -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO case_evidences (
            case_id, evidence_type, description, original_filename, stored_filename,
            file_path, file_size, content_type
        )
        VALUES (
            #{caseId}, #{evidenceType}, #{description}, #{originalFilename}, #{storedFilename},
            #{filePath}, #{fileSize}, #{contentType}
        )
    </insert>

    <!-- 증빙이 지정된 사건에 속할 때만 파일 정보를 반환한다. -->
    <select id="findById" resultMap="caseEvidence">
        SELECT id, case_id, evidence_type, description, original_filename, stored_filename,
               file_path, file_size, content_type, case_evidences_analysis_status,
               created_at, updated_at
        FROM case_evidences
        WHERE case_id = #{caseId}
          AND id = #{evidenceId}
    </select>
</mapper>
